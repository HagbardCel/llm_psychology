# Environment Configuration Example
# Copy this file to .env and fill in the values.

# ============================================
# Normal local application
# ============================================

# Chat Completions base URL (required for real model calls).
LLM_BASE_URL=http://127.0.0.1:8080/v1

# Optional API key. May be empty for unauthenticated local servers.
# LLM_API_KEY=

# Default model name for the session role (live intake/therapy interaction).
MODEL_NAME=local-model

# Optional stronger supervisor endpoint/model. Omitted values inherit the
# session settings above. An explicitly empty JUNG_SUPERVISOR_LLM_API_KEY
# clears the inherited credential so the session secret is not sent to the
# supervisor endpoint (the adapter still uses its existing SDK placeholder).
# JUNG_SUPERVISOR_LLM_BASE_URL=http://127.0.0.1:8081/v1
# JUNG_SUPERVISOR_MODEL_NAME=stronger-model
# JUNG_SUPERVISOR_LLM_API_KEY=
# JUNG_SUPERVISOR_LLM_EXTRA_BODY_JSON='{}'
# JUNG_SUPERVISOR_LLM_DEFAULT_HEADERS_JSON='{}'
#
# '{}' for supervisor headers/extra body clears inherited role-level session
# JSON options. Task-specific extra_body in JUNG_LLM_TASK_CONFIG_JSON still
# applies to the owning role's adapter.

# Data directory for SQLite (`{JUNG_DATA_DIR}/jung.db`). Default is ./data.
# JUNG_DATA_DIR=./data

# Composition shutdown timeout (seconds).
# JUNG_SHUTDOWN_TIMEOUT=30.0

# ============================================
# Standalone API bind (jung-api only)
# ============================================
# Parsed as part of shared JungSettings; runtime bind semantics apply only to
# standalone `jung-api`. Managed `jung` / `make run` always uses an ephemeral
# IPv4 loopback port and does not use these for socket binding.

# JUNG_API_HOST=127.0.0.1
# JUNG_API_PORT=8000
# JUNG_API_ALLOW_REMOTE_BIND=false

# ============================================
# API logging / CORS (managed jung and jung-api)
# ============================================

# JUNG_API_LOG_LEVEL=info
# Comma-separated browser origins for HTTP CORS.
# JUNG_API_ALLOWED_ORIGINS=http://frontend.test

# ============================================
# Diagnostics / advanced LLM overrides
# ============================================

# JUNG_ENABLE_LLM_TRACING=false
# Explicit local diagnostic capture (new directory per run; sensitive trace.jsonl):
# JUNG_DEBUG_RUN_DIR=./logs/debug-runs/debug-run-001
#
# For timestamped names, set JUNG_DEBUG_RUN_DIR in the invoking shell
# rather than inside this dotenv file. Treat the run directory like the
# local database: it may contain prompts and patient text.
#
# Surrounding single quotes are removed by dotenv and are not part of the JSON value.
# JUNG_LLM_EXTRA_BODY_JSON='{"chat_template_kwargs":{"enable_thinking":false}}'
# LM Studio / thinking models: assistant prefill for prompt-mode calls and the
# synthetic patient actor (skipped for json_schema/json_object). See evals/README.md.
# JUNG_LLM_THINKING_PREFILL=1
# Per-task inference policy only (temperature, timeouts, token caps, structured
# mode, extra_body). Do not set "model" here — model ownership is by role.
# JUNG_LLM_TASK_CONFIG_JSON='{"assessment":{"structured_output_mode":"json_object","max_completion_tokens":4096}}'
# JUNG_LLM_DEFAULT_HEADERS_JSON='{"Authorization":"Bearer example"}'

# Local-model smoke (make smoke-local-llm); not loaded by JungSettings — export in shell:
# LOCAL_LLM_SMOKE_SERVER=llama.cpp
# LOCAL_LLM_SMOKE_SERVER_VERSION=<actual llama.cpp version>
# LOCAL_LLM_SMOKE_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_SMOKE_MODEL=ggml-org/Qwen3.6-35B-A3B-MTP-GGUF
# LOCAL_LLM_SMOKE_STRUCTURED_MODE=json_schema
# LOCAL_LLM_SMOKE_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
# LOCAL_LLM_SMOKE_STRICT_ACCEPTANCE=true
# OPENAI_API_KEY=jung-diagnostic-secret-<unique>
